# ==============================================================================
# Contoh Konfigurasi Produksi SIPMAS (.env)
# Salin berkas ini menjadi .env di folder deploy server, lalu isi nilai asli.
# JANGAN PERNAH menyimpan atau meng-commit .env berisi rahasia asli ke Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Basis Data MySQL (WAJIB)
# ------------------------------------------------------------------------------
# Kata sandi root MySQL (hanya untuk administrasi/backup, tidak boleh kosong)
# Buat dengan: openssl rand -hex 16
# Catatan: gunakan huruf dan angka saja karena kata sandi database disisipkan ke URL koneksi.
DB_PASSWORD=ganti-dengan-hasil-openssl-rand-hex-16-root

# Kata sandi user aplikasi non-root (sipmas_app) untuk akses db_sipmas
# Buat dengan: openssl rand -hex 16 (harus berbeda dari DB_PASSWORD)
# Catatan: gunakan huruf dan angka saja karena nilai ini dimasukkan langsung ke DATABASE_URL.
DB_APP_PASSWORD=ganti-dengan-hasil-openssl-rand-hex-16-app

# Koneksi Prisma backend (compose otomatis memakai DB_APP_PASSWORD ke host mysql:3306/db_sipmas;
# jaga agar nilai ini sinkron bila menjalankan skrip CLI atau Prisma secara manual)
DATABASE_URL="mysql://sipmas_app:ganti-dengan-hasil-openssl-rand-hex-16-app@mysql:3306/db_sipmas"

# ------------------------------------------------------------------------------
# 2. Keamanan, CORS & Reverse Proxy (WAJIB)
# ------------------------------------------------------------------------------
# Kunci JWT acak satu baris (buat dengan: openssl rand -hex 48)
JWT_SECRET="ganti-dengan-hasil-openssl-rand-hex-48"

# Origin publik untuk validasi CORS backend:
# - Tunnel bernama (domain tetap): https://sipmas.my.id
# - Quick tunnel (trycloudflare.com): perbarui dengan URL dari log cloudflared lalu jalankan:
#   docker compose -f docker-compose.prod.yml up -d backend
FRONTEND_URL="https://sipmas.my.id"

# Jumlah hop proxy tepercaya di depan backend:
# Alur produksi adalah visitor -> Cloudflare -> cloudflared -> Caddy -> backend.
# Caddy dan cloudflared merupakan 2 hop internal di jaringan Docker, sehingga TRUST_PROXY=2
# agar req.ip dan rate limiter membaca IP asli pengunjung.
TRUST_PROXY=2

# Ambang keyakinan minimum klasifikasi NLP (0.0 - 1.0, default 0.5)
NLP_MIN_CONFIDENCE=0.5

# ------------------------------------------------------------------------------
# 3. Pengiriman Email OTP via SMTP (WAJIB di Produksi)
# ------------------------------------------------------------------------------
# Contoh menggunakan Gmail SMTP + App Password 16 karakter tanpa spasi:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=akun_gmail_anda@gmail.com
SMTP_PASS=app_password_16_huruf_tanpa_spasi
SMTP_FROM="SIPMAS Layanan <akun_gmail_anda@gmail.com>"

# ------------------------------------------------------------------------------
# 4. Inisialisasi Akun Admin (Prisma Seed — Terpisah dari Startup Aplikasi)
# ------------------------------------------------------------------------------
# Akun admin dibuat lewat perintah seed terpisah saat deploy pertama kali.
# Biarkan ADMIN_PASSWORD kosong! Isi hanya sementara via environment saat menjalankan
# skrip seed admin, lalu pastikan tidak meninggalkan password admin di berkas .env.
ADMIN_EMAIL="admin@sipmas.my.id"
ADMIN_PASSWORD=""
ADMIN_NIK="0000000000000001"
ADMIN_NAMA="Administrator SIPMAS"

# ------------------------------------------------------------------------------
# 5. Cloudflare Tunnel & Image GHCR (Opsional)
# ------------------------------------------------------------------------------
# Token Cloudflare Tunnel dari dashboard Zero Trust (hanya wajib jika memakai --profile tunnel-named)
TUNNEL_TOKEN=""

# Pemilik repositori GHCR huruf kecil (default: nji005) dan tag image (default: latest; isi commit SHA untuk rollback)
GHCR_OWNER=nji005
IMAGE_TAG=latest

# Retensi backup lokal dalam hari (default: 7 hari untuk infra/scripts/backup-db.sh)
BACKUP_RETENTION_DAYS=7

